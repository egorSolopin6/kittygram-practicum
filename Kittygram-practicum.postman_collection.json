{
  "info": {
    "name": "Kittygram — текущий рейтинг — Солопин",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Базовый практикум. Запустить Kittygram в Docker Desktop, задать demo_password из локального .env. Запускать последовательно; временный кот удаляется. Секретов в коллекции нет."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "demo_password",
      "value": ""
    },
    {
      "key": "owner_token",
      "value": ""
    },
    {
      "key": "boris_token",
      "value": ""
    },
    {
      "key": "viewer_token",
      "value": ""
    },
    {
      "key": "cat_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Токен anna",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/token/",
        "description": "Ожидаемый HTTP 200",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"anna\",\n  \"password\": \"{{demo_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"owner_token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
